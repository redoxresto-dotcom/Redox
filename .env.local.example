# =============================================================================
#  Proyecto Supabase: redox  (ref: yqzsrzmzramiandpwrni)
#  Copiar este archivo como .env.local y completar los valores reales.
#  Los valores se sacan de: Supabase Dashboard → Project Settings → API Keys
# =============================================================================

# URL del proyecto. Este valor ya es el correcto para tu ref.
NEXT_PUBLIC_SUPABASE_URL=https://yqzsrzmzramiandpwrni.supabase.co

# Clave pública (anon / publishable). Viaja al navegador — está protegida por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=pegar_aca_la_anon_key

# Clave privada (service_role / secret). NUNCA con prefijo NEXT_PUBLIC_.
# Bypassea RLS: si se filtra, alguien puede leer y borrar toda la base.
SUPABASE_SERVICE_ROLE_KEY=pegar_aca_la_service_role_key

# Token compartido que deberán enviar las mesas de pool en el webhook (Fase 4).
# Inventá una cadena larga y aleatoria.
POOL_WEBHOOK_SECRET=pegar_aca_un_token_largo_y_aleatorio

# URL base pública, se usa para generar los QR de las mesas.
# En desarrollo: http://localhost:3000
# En producción (Vercel): https://redox-ovkw.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
